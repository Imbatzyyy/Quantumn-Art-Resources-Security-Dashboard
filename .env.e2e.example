# Copy to .env.e2e and keep that file local. Never commit passwords.
# Use only an isolated deploy/branch preview backed by a separate fictional
# Supabase test project. Production hosts such as quantumnhr.com are rejected.
E2E_BASE_URL=https://deploy-preview-000--your-test-site.netlify.app
E2E_DATA_CLASSIFICATION=fictional-classroom-only

E2E_ADMIN_EMAIL=admin@quantum.test
E2E_ADMIN_PASSWORD=
E2E_EMPLOYEE_EMAIL=employee@quantum.test
E2E_EMPLOYEE_PASSWORD=
