# Supabase is the only HRMS system of record. The publishable browser key is
# safe only when Row-Level Security is enabled.
# Never place a Supabase secret/service-role key in a VITE_ variable.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Netlify Functions only. Configure these in Netlify environment variables;
# never prefix a secret key with VITE_ and never commit its value.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PUBLISHABLE_KEY=

# Transactional account and invitation email delivery. Server-side only.
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Public application origin used to build secure invitation links.
APP_URL=
