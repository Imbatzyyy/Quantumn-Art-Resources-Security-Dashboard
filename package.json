{
  "name": "quantum-hrms-react",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:visual": "playwright test",
    "test:visual:update": "playwright test --update-snapshots",
    "test:e2e": "node --env-file-if-exists=.env.e2e node_modules/@playwright/test/cli.js test --config playwright.authenticated.config.ts",
    "test:e2e:local": "node scripts/run-local-authenticated-qa.mjs",
    "test:db:local": "supabase test db --local",
    "test:qa:local": "npm run local:supabase:start && npm run test:db:local && npm run test:e2e:local",
    "local:app": "node scripts/start-local-qa.mjs",
    "local:supabase:start": "supabase start",
    "local:supabase:reset": "supabase db reset --local",
    "local:supabase:stop": "supabase stop",
    "check": "npm run typecheck && npm run lint && npm run test && npm run test:visual && npm run build"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.112.4",
    "lucide-react": "1.34.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router-dom": "7.18.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "6.1.0",
    "axe-core": "^4.13.0",
    "eslint": "10.9.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.4",
    "globals": "17.11.0",
    "happy-dom": "^20.12.0",
    "supabase": "2.116.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.68.0",
    "vite": "8.2.2",
    "vitest": "^4.1.11"
  }
}
